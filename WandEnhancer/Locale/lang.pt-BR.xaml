<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:s="clr-namespace:System;assembly=mscorlib">

    <!--#region Language Metadata -->
    <s:String x:Key="language_display_name">Português</s:String>
    <!--#endregion -->

    <!--#region MainWindow -->
    <s:String x:Key="mw_folder_path">Caminho da pasta</s:String>
    <s:String x:Key="mw_folder_not_found">Pasta não encontrada</s:String>
    <s:String x:Key="mw_patch">Aplicar</s:String>
    <s:String x:Key="mw_restore">Restaurar</s:String>
    <s:String x:Key="mw_source_code">Código fonte</s:String>
    <s:String x:Key="mw_made_by">Feito com ❤️ por Abdelrahman Ayman (@abdelrahmanayman722-ops)</s:String>
    <s:String x:Key="mw_star_hint">Dê uma estrela se isso te ajudou ;)</s:String>
    <s:String x:Key="mw_auto_doctor">Auto-Doctor e Reparador de Ambiente</s:String>
    <s:String x:Key="mw_copy_logs">Copiar logs para a área de transferência</s:String>
    <s:String x:Key="mw_export_logs">Exportar logs para arquivo</s:String>
    <s:String x:Key="mw_update_badge">Nova versão disponível</s:String>
    <!--#endregion -->

    <!--#region Settings -->
    <s:String x:Key="settings_title">Configurações</s:String>
    <s:String x:Key="settings_language">Idioma</s:String>
    <s:String x:Key="settings_check_updates">Verificar atualizações ao iniciar</s:String>
    <s:String x:Key="settings_check_prereleases">Também notificar sobre pré-lançamentos</s:String>
    <s:String x:Key="settings_run_auto_doctor">Auto-Doctor e Correção de Ambiente (1 Clique)</s:String>
    <s:String x:Key="settings_configure_firewall">Configurar Firewall do Windows (Porta 3223)</s:String>
    <s:String x:Key="settings_run_diagnostics">Executar Diagnóstico do Sistema</s:String>
    <s:String x:Key="settings_save">Salvar</s:String>
    <!--#endregion -->

    <!--#region UpdatePopup -->
    <s:String x:Key="up_popup_title">Atualização disponível</s:String>
    <s:String x:Key="up_warning">SovereignTitan nunca se atualiza sozinho. Compile a nova versão no seu fork ou abra a página de lançamentos.</s:String>
    <s:String x:Key="up_current_version">Atual:</s:String>
    <s:String x:Key="up_latest_version">Mais recente:</s:String>
    <s:String x:Key="up_release_notes">Notas da versão</s:String>
    <s:String x:Key="up_show_more">Mostrar histórico de alterações completo</s:String>
    <s:String x:Key="up_show_less">Mostrar notas da versão</s:String>
    <s:String x:Key="up_loading_changelog">Carregando...</s:String>
    <s:String x:Key="up_changelog_failed">Não foi possível carregar o histórico de alterações completo.</s:String>
    <s:String x:Key="up_release_notes_unavailable">Nenhuma nota de versão foi publicada.</s:String>
    <s:String x:Key="up_open_release">Abrir página de lançamento</s:String>
    <!--#endregion -->

    <!--#region EnhanceVectorsPopup -->
    <s:String x:Key="pv_activate_pro">Ativar WeMod Pro</s:String>
    <s:String x:Key="pv_devtools">DevTools no F12</s:String>
    <s:String x:Key="pv_disable_updates">Desativar atualizações</s:String>
    <s:String x:Key="pv_remote_web_panel_preview">Ativar acesso remoto (beta)</s:String>
    <s:String x:Key="pv_custom_scripts">Scripts personalizados</s:String>
    <s:String x:Key="pv_add_js_scripts">Adicionar .js</s:String>
    <s:String x:Key="pv_custom_scripts_hint">Os arquivos .js selecionados são empacotados no Wand e carregados no renderer.</s:String>
    <s:String x:Key="pv_no_custom_scripts">Nenhum script selecionado</s:String>
    <s:String x:Key="pv_start">Iniciar</s:String>
    <s:String x:Key="pv_auto_apply">Aplicar automaticamente após atualizações</s:String>
    <s:String x:Key="pv_patch_method">Método de patch</s:String>
    <s:String x:Key="pv_strategy_static">Static (recomendado)</s:String>
    <s:String x:Key="pv_strategy_supervised">Supervised</s:String>
    <s:String x:Key="pv_strategy_hint">Static edita o Wand no disco, o que quebra sua assinatura digital. Supervised aplica o patch na memória a cada inicialização - pode acionar o antivírus e talvez não funcione em todas as configurações.</s:String>
    <s:String x:Key="pv_popup_title">O que vamos melhorar?</s:String>
    <!--#endregion -->

    <!--#region CloseWandConfirmPopup -->
    <s:String x:Key="cwc_popup_title">Wand está em execução</s:String>
    <s:String x:Key="cwc_message">{0} precisa ser fechado antes de continuar.</s:String>
    <s:String x:Key="cwc_hint">Qualquer estado não salvo no Wand ou no jogo modificado será perdido. Feche o jogo primeiro se estiver em execução.</s:String>
    <s:String x:Key="cwc_confirm">Forçar encerramento do Wand</s:String>
    <s:String x:Key="cwc_cancel">Cancelar</s:String>
    <!--#endregion -->

    <!--#region Runtime log -->
    <s:String x:Key="log_install_found">Diretório do WeMod encontrado em {0} ({1})</s:String>
    <s:String x:Key="log_already_patched">O WeMod já foi modificado. Se quiser modificar novamente, restaure o backup primeiro.</s:String>
    <s:String x:Key="log_ready">Pronto para modificar.</s:String>
    <s:String x:Key="log_install_not_found">Diretório do WeMod não encontrado.</s:String>
    <s:String x:Key="log_no_directory">Não é possível fazer isso. Por favor, especifique o diretório primeiro.</s:String>
    <s:String x:Key="log_invalid_directory">A pasta selecionada {0} não é um diretório válido do WeMod.</s:String>
    <s:String x:Key="log_restore_failed">Falha ao restaurar o backup: {0}</s:String>
    <s:String x:Key="log_patch_failed">Falha ao modificar: {0}</s:String>
    <s:String x:Key="log_copied">Logs copiados para a área de transferência.</s:String>
    <s:String x:Key="log_copy_failed">Falha ao copiar logs: {0}</s:String>
    <s:String x:Key="log_exported">Logs exportados para {0}.</s:String>
    <s:String x:Key="log_export_failed">Falha ao exportar logs: {0}</s:String>
    <s:String x:Key="log_open_link_failed">Não foi possível abrir {0} no navegador.</s:String>
    <s:String x:Key="dialog_pick_install">Selecione o diretório do WeMod</s:String>
    <!--#endregion -->

</ResourceDictionary>
