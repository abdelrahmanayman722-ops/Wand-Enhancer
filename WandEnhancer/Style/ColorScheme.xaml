<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- SovereignTitan Cyberpunk Obsidian & Neon Cyan Palette -->
    <SolidColorBrush x:Key="Background" Color="#070A13"/>
    <SolidColorBrush x:Key="Foreground" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="Card" Color="#0D1527"/>
    <SolidColorBrush x:Key="CardForeground" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="Popover" Color="#080D1A"/>
    <SolidColorBrush x:Key="PopoverForeground" Color="#F0F6FC"/>
    <SolidColorBrush x:Key="Primary" Color="#00F0FF"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#030712"/>
    <SolidColorBrush x:Key="Secondary" Color="#10233B"/>
    <SolidColorBrush x:Key="SecondaryForeground" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Muted" Color="#0F172A"/>
    <SolidColorBrush x:Key="MutedForeground" Color="#94A3B8"/>
    <SolidColorBrush x:Key="Accent" Color="#0C2847"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#38BDF8"/>
    <SolidColorBrush x:Key="Destructive" Color="#FF3366"/>
    <SolidColorBrush x:Key="DestructiveForeground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Border" Color="#163252"/>
    <SolidColorBrush x:Key="Input" Color="#09101F"/>
    <SolidColorBrush x:Key="Ring" Color="#00F0FF"/>
    <SolidColorBrush x:Key="NeonCyan" Color="#00F0FF"/>
    <SolidColorBrush x:Key="CyanGlow" Color="#14B8A6"/>
</ResourceDictionary>